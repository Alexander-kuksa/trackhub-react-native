{
  "name": "@daively/react-native",
  "version": "0.1.3",
  "description": "Daively attribution, engagement and billing context for React Native",
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/Alexander-kuksa/trackhub-react-native.git"},
  "homepage": "https://github.com/Alexander-kuksa/trackhub-react-native#readme",
  "bugs": {"url": "https://github.com/Alexander-kuksa/trackhub-react-native/issues"},
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "files": ["src", "lib", "android", "ios", "example/*.tsx", "TrackHubReactNative.podspec", "react-native.config.js", "README.md", "VALIDATION.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "codegen:check": "node tests/codegen-check.cjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {"react": "^19.2.3", "react-native": "0.85.3 || >=0.87.0 <0.88.0"},
  "devDependencies": {"@types/react": "19.2.3", "react": "19.2.7", "react-native": "0.85.3", "typescript": "5.9.3"},
  "engines": {"node": ">=22.13.0"},
  "codegenConfig": {
    "name": "TrackHubReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {"javaPackageName": "com.trackhub.reactnative"},
    "ios": {"modulesProvider": {"NativeTrackHub": "RCTTrackHub"}}
  }
}
